# Windows scripts must retain CRLF in checkouts and release archives.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source and documentation use LF.
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Binary assets are never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.pdf binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.zip binary
*.gz binary
*.tar binary
*.whl binary

# Keep development files out of release ZIPs (clones still contain them).
tests/          export-ignore
docs/           export-ignore
.gitignore      export-ignore
.gitattributes  export-ignore
.github/        export-ignore
