include README.md
include LICENSE
include requirements.txt
recursive-include requirements *.txt
include setup_windows.bat
recursive-include assets *.ico *.png
recursive-include assets/fonts *.ttf OFL-*.txt
# Git-ignored development notes may exist in a local source tree. Package
# only public documentation, including when a previous SOURCES.txt exists.
prune docs
recursive-include docs/i18n README*.md
